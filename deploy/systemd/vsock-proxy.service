# systemd unit for the TTKServer `vsock-proxy` on the Nitro Enclave's parent instance: relays
# public QUIC (UDP 443) into the enclave over vsock, and the enclave's outbound traffic back out.
#
# Install:
#   cargo build --release -p ttk-core --bin vsock-proxy
#   sudo install -m 0755 target/release/vsock-proxy /usr/local/bin/vsock-proxy
#   sudo install -m 0644 deploy/systemd/vsock-proxy.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now vsock-proxy
#
# Configure in /etc/default/vsock-proxy (optional; overrides the defaults below), e.g.
#   TTK_ENCLAVE_CID=16             # must match `nitro-cli run-enclave --enclave-cid`
#   TTK_RELAY_LISTEN=0.0.0.0:443   # public UDP address
#   TTK_VSOCK_PORT=5000            # enclave server's vsock port
#   TTK_OUTBOUND_VSOCK_PORT=5001   # outbound relaying from the enclave; 0 disables
#   RUST_LOG=info
#
# Logs: journalctl -u vsock-proxy -f

[Unit]
Description=TTKServer vsock-proxy (public UDP <-> Nitro Enclave vsock)
Documentation=https://github.com/Lanetus/TTKServer
Wants=network-online.target
After=network-online.target nitro-enclaves-allocator.service

[Service]
Type=exec
Environment=TTK_ENCLAVE_CID=16
Environment=TTK_RELAY_LISTEN=0.0.0.0:443
Environment=RUST_LOG=info
EnvironmentFile=-/etc/default/vsock-proxy
ExecStart=/usr/local/bin/vsock-proxy
# The proxy retries the enclave on each new client, but exits if its own sockets fail.
Restart=always
RestartSec=2

# One vsock connection (and, outbound, one UDP socket) per peer, up to 4096 per direction.
LimitNOFILE=16384

# Unprivileged, with only the capability to bind port 443.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Sandboxing: the proxy needs no files, only UDP and vsock sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_VSOCK AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
