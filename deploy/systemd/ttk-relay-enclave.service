# systemd unit that runs the TTKServer relay node Nitro Enclave on the parent instance.
#
# `nitro-cli run-enclave` launches the enclave and returns, so this is a oneshot unit that stays
# active while the enclave runs; stopping it terminates the enclave. Pair it with
# vsock-proxy.service, which relays traffic between the network and the enclave's vsock.
#
# Install:
#   scripts/build-eif.sh amd64 relay      # or arm64, matching the instance
#   sudo install -D -m 0644 out/ttk-relay_v<version>_<arch>.eif /opt/ttkserver/ttk-relay.eif
#   sudo install -m 0644 deploy/systemd/ttk-relay-enclave.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ttk-relay-enclave
#
# The Nitro Enclaves allocator must reserve at least TTK_ENCLAVE_CPUS and TTK_ENCLAVE_MEMORY
# (memory_mib / cpu_count in /etc/nitro_enclaves/allocator.yaml, then
# `systemctl restart nitro-enclaves-allocator`). nitro-cli reports the minimum memory for the EIF
# if it is set too low.
#
# Configure in /etc/default/ttk-relay-enclave (optional; overrides the defaults below), e.g.
#   TTK_EIF=/opt/ttkserver/ttk-relay.eif
#   TTK_ENCLAVE_CID=16                 # vsock-proxy's TTK_ENCLAVE_CID must match
#   TTK_ENCLAVE_CPUS=2
#   TTK_ENCLAVE_MEMORY=1024            # MiB
#   TTK_ENCLAVE_EXTRA_ARGS=--debug-mode   # debug only: zeroes PCRs, so strict clients reject it
#
# Status: nitro-cli describe-enclaves; logs: journalctl -u ttk-relay-enclave

[Unit]
Description=TTKServer relay node Nitro Enclave
Documentation=https://github.com/Lanetus/TTKServer
Requires=nitro-enclaves-allocator.service
After=nitro-enclaves-allocator.service
Before=vsock-proxy.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=TTK_EIF=/opt/ttkserver/ttk-relay.eif
Environment=TTK_ENCLAVE_NAME=ttk-relay
Environment=TTK_ENCLAVE_CID=16
Environment=TTK_ENCLAVE_CPUS=2
Environment=TTK_ENCLAVE_MEMORY=1024
Environment=TTK_ENCLAVE_EXTRA_ARGS=
EnvironmentFile=-/etc/default/ttk-relay-enclave
# Clear an enclave left over from an unclean stop, so its CID and resources are free.
ExecStartPre=-/usr/bin/nitro-cli terminate-enclave --enclave-name ${TTK_ENCLAVE_NAME}
ExecStart=/usr/bin/nitro-cli run-enclave \
    --eif-path ${TTK_EIF} \
    --enclave-name ${TTK_ENCLAVE_NAME} \
    --enclave-cid ${TTK_ENCLAVE_CID} \
    --cpu-count ${TTK_ENCLAVE_CPUS} \
    --memory ${TTK_ENCLAVE_MEMORY} \
    $TTK_ENCLAVE_EXTRA_ARGS
ExecStop=/usr/bin/nitro-cli terminate-enclave --enclave-name ${TTK_ENCLAVE_NAME}
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
